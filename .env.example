# ---- Providers (optional: without these the deterministic offline provider is used) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Role -> provider routing. anthropic | openai | mock ----
AGENT_PROVIDER=anthropic
GUARDRAIL_PROVIDER=anthropic
JUDGE_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# ---- Supabase (optional: without these an in-process store is used) ----
# SUPABASE_SECRET_KEY is the sb_secret_... value from the dashboard. The older
# name SUPABASE_SERVICE_ROLE_KEY is accepted too. Do NOT use the publishable
# (anon) key: this app writes with row-level locks.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- App ----
DISCLOSURE_MODE=info_card
ADMIN_PASSWORD=change-me
CRON_SECRET=change-me
RATE_LIMIT_PER_HOUR=40
SESSION_TURN_CAP=30
